# =============================================================================
# .gitignore for Atmel Studio 7 / Microchip Studio AVR-GCC project
# =============================================================================

# -----------------------------------------------------------------------------
# Build output directories (Debug and Release configurations)
# -----------------------------------------------------------------------------
Debug/
Release/

# Compiled object files
*.o
*.d

# Linked ELF executable
*.elf

# Intel HEX and Motorola SREC flash images
*.hex
*.srec

# EEPROM image
*.eep

# Extended listing (disassembly + source interleave)
*.lss

# Map file (linker memory map)
*.map

# Assembly listing
*.lst

# -----------------------------------------------------------------------------
# Atmel Studio / Microchip Studio IDE files
# -----------------------------------------------------------------------------

# Solution user options (window layout, breakpoints — machine-specific)
*.atsuo

# Atmel Studio solution file (regenerated by IDE; keep .cproj, ignore .atsln
# only if you prefer — some teams commit it to pin the IDE configuration)
# *.atsln

# Temporary project files
*.tmp
*.bak
*.orig

# IDE user preferences
.vs/
*.user

# -----------------------------------------------------------------------------
# Windows OS artefacts
# -----------------------------------------------------------------------------
Thumbs.db
Desktop.ini
ehthumbs.db

# -----------------------------------------------------------------------------
# macOS artefacts (if repository is ever opened on macOS)
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride

# -----------------------------------------------------------------------------
# Linux artefacts
# -----------------------------------------------------------------------------
*~

# -----------------------------------------------------------------------------
# Editor artefacts
# -----------------------------------------------------------------------------

# Visual Studio Code
.vscode/

# Vim
*.swp
*.swo

# Emacs
\#*\#
.\#*
